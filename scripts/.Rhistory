# ------------------------------------------------------------------------------
# ----- Further ASV Assignment Corrections ------------------------------------
# ------------------------------------------------------------------------------
# Helper function to reorder hashes between ASV positions
reorder_ASVs <- function(data, target, source) {
old_hashes <- setNames(data$name, data$ASV)
data$name[match(target, data$ASV)] <- old_hashes[source]
data
}
# 1. Reorder ASV19–ASV23: 20, 22, 19, 21, 23
data_ASVs <- reorder_ASVs(
data_ASVs,
paste0("ASV", 19:23),
paste0("ASV", c(20, 22, 19, 21, 23))
)
# 2. Swap ASV24 and ASV25
data_ASVs <- reorder_ASVs(
data_ASVs,
paste0("ASV", 24:25),
paste0("ASV", c(25, 24))
)
# 3. Swap ASV42 and ASV43
data_ASVs <- reorder_ASVs(
data_ASVs,
paste0("ASV", 42:43),
paste0("ASV", c(43, 42))
)
# 4. Reorder ASV45–ASV47: 47, 45, 46
data_ASVs <- reorder_ASVs(
data_ASVs,
paste0("ASV", 45:47),
paste0("ASV", c(47, 45, 46))
)
# Update hash mapping
data_ASVs$silva <- data_ASVs$name
# Verify
stopifnot(
nrow(data_ASVs) == 50,
!anyNA(data_ASVs$name),
!anyDuplicated(data_ASVs$name)
)
# Save updated mapping
write_csv(
data_ASVs,
here("data", "data_ASVs.csv")
)
